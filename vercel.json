{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/upload/**/*.ts": {
      "maxDuration": 600
    },
    "app/api/quiz/**/*.ts": {
      "maxDuration": 600
    },
    "app/api/ai/**/*.ts": {
      "maxDuration": 600
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}